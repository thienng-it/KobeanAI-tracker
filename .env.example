# Server Configuration
PORT=3000
NODE_ENV=development

# Database Persistence
# In production, this can be set to /app/data/sqlite.db or any persistent volume path
DATABASE_PATH=./data/sqlite.db

# Security & CORS
# Comma-separated list of allowed origins (e.g. http://localhost:5173,https://my-domain.com)
CORS_ORIGIN=http://localhost:5173

# Rate Limiting (windowMs in milliseconds, max requests per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
